PORT=
URL=
CRON_SECRET=
# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# development: pretty logs and API docs at /docs (set by `pnpm start:dev`).
# Anything else, including empty: JSON logs, no API docs.
NODE_ENV=
# trace | debug | info (default) | warn | error | silent
LOG_LEVEL=

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Number of reverse proxies in front of the API (e.g. 1). Leave empty when clients connect directly.
TRUST_PROXY=

# Where bill photos are stored (default: ./uploads; /app/uploads in the container)
UPLOADS_DIR=
